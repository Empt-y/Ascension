/target
*.log
/screenshots
# Per-model nature previews are regenerated by tools/build_nature.py; only the sheets are kept.
/assets/models/nature/previews/*.png
!/assets/models/nature/previews/sheet_*.png
__pycache__/

# Per-model ore previews are regenerated by tools/build_ores.py --previews; only the sheets are kept.
/assets/models/ores/previews/*.png
!/assets/models/ores/previews/sheet_*.png
